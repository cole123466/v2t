# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 运行日志（dev server / nohup 输出）
*.log
nohup.out

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 任务数据（媒体文件与 SQLite 库不入库）
/data

# 外部参考工程索引
.projectindex/
.projetcIndex/

# ZCode 本地会话配置
/.zcode

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.scratch/*.log
.scratch/*.html
.scratch/msg.txt

# agent 集成记录只保留本地，不入库
docs/agents/

# 桌宠角色素材（TYPE-MOON 同人作品，版权归权利人，不入库）
# 获取方式见 docs/pet-embed.md「新增宠物」
public/pets/*/
public/pets/*.webp
!public/pets/index.json
