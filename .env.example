# 硅基流动（转写）
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# 智谱 bigmodel（文案与图文文章生成，OpenAI 兼容）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-bigmodel-key
# 纯文本模型（文案模板）
LLM_MODEL=glm-4.6

# 图文文章用的视觉模型（需支持图片输入）。
# glm-4.6v      稳定可用（推荐）
# glm-4.6v-flash 免费，但高峰期可能 429
# glm-4.5v      只输出思维链、不出正文，不要用
LLM_VISION_MODEL=glm-4.6v

# 运行参数
MEDIA_RETENTION_DAYS=7
MAX_UPLOAD_GB=2

# 链接导入的可选登录 Cookie 文件（Netscape 格式，由浏览器扩展导出）。
# 留空 = 完全免登录：B 站可下载免登录可达的清晰度，但拿不到平台字幕；
# 提供后：可使用更高清晰度，并在部分平台获得字幕轨道。
DOWNLOADER_COOKIES_FILE=
